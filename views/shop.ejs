<%- include('./partials/header') %>

    <% if (success && success.length> 0) { %>
        <div class="absolute top-5 left-1/2 -translate-x-1/2 p-3 rounded-md bg-blue-500">
            <span class="inline-block mt-1 mb-1 text-white">
                <%= success %>
            </span>
        </div>
        <% } %>

            <div class="w-full min-h-screen flex items-start px-20 py-20">

                <!-- Sidebar -->
                <div class="w-[25%] flex flex-col items-start">

                    <div class="flex items-center gap-2">
                        <h3>Sort By</h3>

                        <form action="/shop" method="GET">
                            <select class="border-[1px] px-2 py-1" name="sortby" onchange="this.form.submit()">
                                <option value="popular">Popular</option>
                                <option value="newest">Newest</option>
                            </select>
                        </form>
                    </div>

                    <div class="flex flex-col mt-20">
                        <a class="block w-fit mb-2" href="/shop">
                            New Collection
                        </a>

                        <a class="block w-fit mb-2" href="/shop">
                            All Products
                        </a>

                        <a class="block w-fit mb-2" href="/shop">
                            Discounted Products
                        </a>
                    </div>

                    <div class="mt-32">
                        <a class="block w-fit mb-2" href="#">
                            Filter By:
                        </a>

                        <a class="block w-fit mb-2" href="#">
                            Availability
                        </a>

                        <a class="block w-fit mb-2" href="#">
                            Discount
                        </a>
                    </div>

                </div>


                <!-- Products -->
                <div class="w-[75%] flex flex-col gap-5">

                    <% if (products && products.length> 0) { %>

                        <div class="flex flex-wrap items-start gap-5">

                            <% products.forEach(function(product) { %>

                                <div class="w-60">

                                    <!-- Product Image -->
                                    <div class="w-full h-52 flex items-center justify-center"
                                        style="background-color: <%= product.bgcolor || '#f5f5f5' %>;">

                                        <% if (product.image) { %>

                                            <img class="h-[12rem] max-w-full object-contain"
                                                src="data:image/jpeg;base64,<%= product.image.toString('base64') %>"
                                                alt="<%= product.name %>">

                                            <% } else { %>

                                                <div class="text-gray-500 text-sm">
                                                    No Image
                                                </div>

                                                <% } %>

                                    </div>


                                    <!-- Product Details -->
                                    <div class="flex justify-between items-center px-4 py-4" style="
                                background-color: <%= product.panelcolor || '#ffffff' %>;
                                color: <%= product.textcolor || '#000000' %>;
                            ">

                                        <div>

                                            <h3>
                                                <%= product.name %>
                                            </h3>

                                            <h4>
                                                ₹ <%= product.price %>
                                            </h4>

                                            <% if (product.discount && product.discount> 0) { %>
                                                <p class="text-sm">
                                                    Discount: ₹ <%= product.discount %>
                                                </p>
                                                <% } %>

                                        </div>


                                        <!-- Add To Cart -->
                                        <a class="w-7 h-7 flex items-center justify-center rounded-full bg-white text-black"
                                            href="/addtocart/<%= product._id %>">
                                            <i class="ri-add-line"></i>
                                        </a>

                                    </div>

                                </div>

                                <% }) %>

                        </div>

                        <% } else { %>

                            <div class="w-full flex items-center justify-center py-20">
                                <h2 class="text-xl text-gray-500">
                                    No products available.
                                </h2>
                            </div>

                            <% } %>

                </div>

            </div>

            <%- include('./partials/footer') %>